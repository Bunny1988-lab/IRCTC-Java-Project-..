# ==============================================================================
# IRCTC Railway Reservation System - Database Configuration Template
# ==============================================================================
# Copy this file to 'db.properties' in this directory and replace with your local
# MySQL database configuration.
#
# NOTE: 'db.properties' is excluded in .gitignore to prevent committing credentials.
# ==============================================================================

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/irctc_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=your_database_password
